{
  "process": "main",
  "sample": 2,
  "window_ms": 1000,
  "head": 400,
  "tail": 100,
  "max_logs": 1000,
  "hooks": [
    {
      "classes": [
        "android.util.Base64"
      ],
      "method": "encodeToString",
      "mode": "log"
    },
    {
      "classes": [
        "android.util.Base64"
      ],
      "method": "decode",
      "mode": "log"
    }
  ]
}